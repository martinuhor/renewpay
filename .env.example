# QDay Aevum testnet. For a local Anvil node use http://127.0.0.1:8545
RPC_URL=https://rpc-test.qday.info

# 32-byte hex private key. Never commit a real key.
DEPLOYER_PRIVATE_KEY=

# Signs subscribe. Use a second local account so the merchant and subscriber differ.
SUBSCRIBER_PRIVATE_KEY=

# Optional. create-plan uses this when set, otherwise DEPLOYER_PRIVATE_KEY.
# MERCHANT_PRIVATE_KEY=

# Optional. The CLI also reads deployments/latest.json, which is gitignored.
# The checkout does not read these. It calls the live Aevum contracts in the README.
# Leave them empty for a local Anvil run.
# SUBSCRIPTION_MANAGER_ADDRESS=0x51202A87aFdc07085e9586bc5E30a81a8cC4ff13
# SESSION_KEY_REGISTRY_ADDRESS=0x5fB5817ABb539C8628b45c0C0eC95797D2C85F26
SUBSCRIPTION_MANAGER_ADDRESS=
SESSION_KEY_REGISTRY_ADDRESS=

# Aevum settlement token. On chain id 44005 the CLI and deploy script refuse any other address.
TUSD8_ADDRESS=0x456569838f1d43009A91ebA4263147Afd7233483

# Optional. The public /api/events route signs with this. It stays on the server.
# RENEWPAY_WEBHOOK_SECRET=
